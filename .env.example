# Copy this file to .env and replace with your actual values
VITE_GEMINI_API_KEY=your_api_key_here
VITE_API_URL=https://fast-api-v.onrender.com
VITE_API_BEARER_TOKEN=replace_with_backend_bearer_token
# Phase 1 sync uses the backend token. Phase 2 can replace this with a Google ID token.
VITE_SYNC_API_URL=https://fast-api-v.onrender.com
VITE_SYNC_AUTH_TOKEN=replace_with_backend_bearer_token
VITE_SYNC_INTERVAL_MS=30000
VITE_SYNC_MAX_RETRIES=5
VITE_SYNC_LINEAR_RETRY_MS=10000
VITE_NOTE_SYNC_WINDOW_DAYS=92
VITE_GOOGLE_CLIENT_ID=
VITE_PDF_EXPORT_API_URL=
VITE_PDF_EXPORT_BEARER_TOKEN=
# Optional service wake-up health endpoints for the "Despertar servicio" button
VITE_FASTAPI_HEALTH_URL=https://fast-api-v.onrender.com/healthz
VITE_N8N_HEALTH_URL=https://n8n-service-ea3k.onrender.com/healthz
# Optional override in milliseconds (default: 7200000 = 2h)
VITE_SERVICE_WAKE_INTERVAL_MS=7200000
